<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 网络访问与状态：认证核心监测校园网、WebView 访问本机 axum 服务 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 前台服务常驻守护：specialUse 类型需配套 FOREGROUND_SERVICE_SPECIAL_USE 权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- 开机自启（BootReceiver；是否生效由设置项 autostart_enabled 决定，默认关闭） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 常驻通知（API 33+ 为运行时权限，MainActivity 启动时请求） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 请求加入电池优化白名单（Doze 保活；弹窗确认流程 TODO(P1) 接入） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- 注意：SCHEDULE_EXACT_ALARM 不需要——守护轮询用普通 Handler 延时，不依赖精确闹钟 -->

    <application
        android:label="@string/app_name"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.CampusAuth">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".AuthForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <!-- targetSdk 34+ 对 specialUse 的强制要求：向系统与应用商店声明该前台服务的具体用途 -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="校园网自动认证守护——前台常驻监测校园网认证状态并在掉线时自动重新认证" />
        </service>

        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
