# Docker 部署文件与 shell 脚本在各平台均须 LF：
# 仓库 core.autocrlf=true 会把 CRLF 写回 Windows 工作区，
# 导致容器里 `exec: /entrypoint.sh: no such file or directory`（shebang 行带 \r）。
docker/*.sh text eol=lf
openwrt/*.sh text eol=lf
openwrt/files/* text eol=lf
openwrt/package/** text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf
docker-compose*.yml text eol=lf
docker/docker-compose*.yml text eol=lf
# openapi 契约与前端生成物参与逐字节比对（npm run typegen:check），Windows
# 工作区必须 LF——autocrlf=true 检出 CRLF 后比对必失败（CI 首跑实锤）：
openapi.json text eol=lf
frontend/src/api/generated/api.d.ts text eol=lf
